print("¿Es estudiante de la UTPL? (V o F)")
estudiante = input().strip().upper() in ("V", "VERDADERO")
print("Ingrese las horas de permanencia")
horas = float(input())

tarifa = horas * 1.00
if estudiante:
    tarifa = tarifa * 0.50
    if horas > 4:
        tarifa = tarifa * 1.20
else:
    if horas > 6:
        tarifa = tarifa * 1.20

print("Monto a pagar: $", tarifa)
