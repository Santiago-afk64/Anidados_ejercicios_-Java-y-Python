import java.util.Scanner;

public class Descuento {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double monto, descuento, mFinal;
        boolean estudianteUtpl;

        System.out.println("Ingrese el monto total");
        monto = sc.nextDouble();
        System.out.println("Es estudiante de la UTPL? (V o F)");
        String respuesta = sc.next().trim().toUpperCase();
        Estudiante = respuesta.equals("V") || respuesta.equals("VERDADERO");

        descuento = 0;
        if (Estudiante) {
            descuento = 0.20;
            if (monto > 30) {
                descuento = descuento + 0.05;
            }
        } else {
            if (monto > 50) {
                descuento = 0.10;
            }
        }

        mFinal = monto * (1 - descuento);
        System.out.println("El monto a apagar es: $" + mFinal);
        System.out.println("Descuento:" + (descuento * 100) + "%");
        sc.close();
    }
}
